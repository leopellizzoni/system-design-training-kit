{
  "version": 1,
  "architecture": {
    "nodes": [
      {
        "id": "alunos",
        "type": "client",
        "name": "Alunos (navegador)",
        "clientMode": "open",
        "rate": 50,
        "mixWrite": 100,
        "x": 0,
        "y": 300
      },
      {
        "id": "lb",
        "type": "loadBalancer",
        "name": "Balanceador",
        "algorithm": "roundRobin",
        "workers": 5000,
        "x": 320,
        "y": 300
      },
      {
        "id": "app1",
        "type": "service",
        "name": "Servidor 1 — sem estado",
        "runtime": "python",
        "cores": 1,
        "workers": 8,
        "serviceMs": 2,
        "queueCapacity": 100,
        "x": 640,
        "y": 235
      },
      {
        "id": "app2",
        "type": "service",
        "name": "Servidor 2 — sem estado",
        "runtime": "python",
        "cores": 1,
        "workers": 8,
        "serviceMs": 2,
        "queueCapacity": 100,
        "x": 640,
        "y": 365
      },
      {
        "id": "sess",
        "type": "cache",
        "name": "Sessões (cache compartilhado) — a sessão fica fora do servidor",
        "engine": "redis",
        "serviceMs": 0,
        "hitRatio": 1.0,
        "workers": 1000,
        "queueCapacity": 500,
        "x": 960,
        "y": 235
      },
      {
        "id": "db",
        "type": "database",
        "name": "Banco (inscrições)",
        "engine": "postgres",
        "serviceMs": 5,
        "cores": 2,
        "workers": 64,
        "queueCapacity": 200,
        "x": 960,
        "y": 365
      }
    ],
    "edges": [
      {
        "from": "alunos",
        "to": "lb"
      },
      {
        "from": "lb",
        "to": "app1"
      },
      {
        "from": "lb",
        "to": "app2"
      },
      {
        "from": "app1",
        "to": "sess"
      },
      {
        "from": "app2",
        "to": "sess"
      },
      {
        "from": "app1",
        "to": "db"
      },
      {
        "from": "app2",
        "to": "db"
      }
    ]
  }
}
