{
  "version": 1,
  "architecture": {
    "nodes": [
      {
        "id": "part",
        "type": "client",
        "name": "Participantes (clicam em 'emitir certificado') — 5 por segundo",
        "clientMode": "open",
        "rate": 5,
        "mixWrite": 100,
        "x": 0,
        "y": 300
      },
      {
        "id": "lb",
        "type": "loadBalancer",
        "name": "Balanceador",
        "algorithm": "roundRobin",
        "workers": 5000,
        "x": 320,
        "y": 300
      },
      {
        "id": "app1",
        "type": "service",
        "name": "Servidor 1 — SÍNCRONO: grava o pedido, enfileira e responde na hora",
        "runtime": "python",
        "cores": 1,
        "workers": 8,
        "serviceMs": 2,
        "queueCapacity": 100,
        "x": 640,
        "y": 235
      },
      {
        "id": "app2",
        "type": "service",
        "name": "Servidor 2 — SÍNCRONO: grava o pedido, enfileira e responde na hora",
        "runtime": "python",
        "cores": 1,
        "workers": 8,
        "serviceMs": 2,
        "queueCapacity": 100,
        "x": 640,
        "y": 365
      },
      {
        "id": "fila",
        "type": "queue",
        "name": "Fila de certificados — ASSÍNCRONO · sintoma: clique espera 30 s",
        "engine": "rabbitmq",
        "cores": 2,
        "workers": 1000,
        "serviceMs": 0,
        "queueCapacity": 20000,
        "x": 960,
        "y": 235
      },
      {
        "id": "db",
        "type": "database",
        "name": "Banco (pedidos; registra 'certificado N enviado')",
        "engine": "postgres",
        "serviceMs": 5,
        "cores": 2,
        "workers": 64,
        "queueCapacity": 200,
        "x": 960,
        "y": 365
      },
      {
        "id": "worker",
        "type": "service",
        "name": "Worker — ASSÍNCRONO: gera o PDF e envia o e-mail · idempotente (checa antes de enviar)",
        "runtime": "python",
        "cores": 8,
        "processes": 4,
        "workers": 32,
        "serviceMs": 40,
        "queueCapacity": 0,
        "x": 1280,
        "y": 300
      },
      {
        "id": "obj",
        "type": "database",
        "name": "Armazenamento de objetos (PDFs)",
        "engine": "s3",
        "serviceMs": 0,
        "cores": 0,
        "workers": 20000,
        "shards": 8,
        "readCapacity": 44000,
        "writeCapacity": 28000,
        "objectMb": 1,
        "bandwidthMbps": 640,
        "queueCapacity": 0,
        "x": 1600,
        "y": 235
      },
      {
        "id": "email",
        "type": "service",
        "name": "Serviço de e-mail (de fora)",
        "runtime": "go",
        "cores": 0,
        "workers": 100,
        "serviceMs": 0,
        "waitMs": 2000,
        "queueCapacity": 0,
        "failRate": 0.02,
        "x": 1600,
        "y": 365
      }
    ],
    "edges": [
      {
        "from": "part",
        "to": "lb"
      },
      {
        "from": "lb",
        "to": "app1"
      },
      {
        "from": "lb",
        "to": "app2"
      },
      {
        "from": "app1",
        "to": "db"
      },
      {
        "from": "app2",
        "to": "db"
      },
      {
        "from": "app1",
        "to": "fila"
      },
      {
        "from": "app2",
        "to": "fila"
      },
      {
        "from": "fila",
        "to": "worker",
        "consumers": 8
      },
      {
        "from": "worker",
        "to": "obj"
      },
      {
        "from": "worker",
        "to": "email"
      },
      {
        "from": "worker",
        "to": "db"
      }
    ]
  }
}
