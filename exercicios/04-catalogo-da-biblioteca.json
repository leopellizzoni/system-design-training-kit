{
  "version": 1,
  "architecture": {
    "nodes": [
      {
        "id": "alunos",
        "type": "client",
        "name": "Alunos (buscam no catálogo) — 1.000 buscas por segundo",
        "clientMode": "open",
        "rate": 1000,
        "mixRead": 100,
        "x": 0,
        "y": 235
      },
      {
        "id": "bib",
        "type": "client",
        "name": "Bibliotecária (cadastra livros) — 1 cadastro por segundo",
        "clientMode": "open",
        "rate": 1,
        "mixWrite": 100,
        "x": 0,
        "y": 365
      },
      {
        "id": "lb",
        "type": "loadBalancer",
        "name": "Balanceador",
        "algorithm": "roundRobin",
        "workers": 5000,
        "x": 320,
        "y": 300
      },
      {
        "id": "app1",
        "type": "service",
        "name": "Servidor 1",
        "runtime": "python",
        "cores": 8,
        "workers": 128,
        "serviceMs": 0.05,
        "queueCapacity": 100,
        "x": 640,
        "y": 235
      },
      {
        "id": "app2",
        "type": "service",
        "name": "Servidor 2",
        "runtime": "python",
        "cores": 8,
        "workers": 128,
        "serviceMs": 0.05,
        "queueCapacity": 100,
        "x": 640,
        "y": 365
      },
      {
        "id": "db",
        "type": "database",
        "name": "Banco (catálogo) — sobrecarregado",
        "engine": "postgres",
        "serviceMs": 5,
        "cores": 2,
        "workers": 64,
        "queueCapacity": 200,
        "x": 960,
        "y": 300
      }
    ],
    "edges": [
      {
        "from": "alunos",
        "to": "lb"
      },
      {
        "from": "bib",
        "to": "lb"
      },
      {
        "from": "lb",
        "to": "app1"
      },
      {
        "from": "lb",
        "to": "app2"
      },
      {
        "from": "app1",
        "to": "db"
      },
      {
        "from": "app2",
        "to": "db"
      }
    ]
  }
}
