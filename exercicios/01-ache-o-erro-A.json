{
  "version": 1,
  "architecture": {
    "nodes": [
      {
        "id": "alunos",
        "type": "client",
        "name": "Alunos (buscam no catálogo)",
        "clientMode": "open",
        "rate": 1000,
        "mixRead": 100,
        "x": 0,
        "y": 300
      },
      {
        "id": "cache",
        "type": "cache",
        "name": "Cache de buscas",
        "engine": "redis",
        "serviceMs": 0,
        "hitRatio": 0.9,
        "workers": 1000,
        "queueCapacity": 500,
        "x": 320,
        "y": 300
      },
      {
        "id": "lb",
        "type": "loadBalancer",
        "name": "Balanceador",
        "algorithm": "roundRobin",
        "workers": 5000,
        "x": 640,
        "y": 300
      },
      {
        "id": "app1",
        "type": "service",
        "name": "Servidor 1",
        "runtime": "python",
        "cores": 8,
        "workers": 128,
        "serviceMs": 0.05,
        "queueCapacity": 100,
        "x": 960,
        "y": 235
      },
      {
        "id": "app2",
        "type": "service",
        "name": "Servidor 2",
        "runtime": "python",
        "cores": 8,
        "workers": 128,
        "serviceMs": 0.05,
        "queueCapacity": 100,
        "x": 960,
        "y": 365
      },
      {
        "id": "db",
        "type": "database",
        "name": "Banco (catálogo)",
        "engine": "postgres",
        "serviceMs": 5,
        "cores": 2,
        "workers": 64,
        "queueCapacity": 200,
        "x": 1280,
        "y": 300
      }
    ],
    "edges": [
      {
        "from": "alunos",
        "to": "cache"
      },
      {
        "from": "cache",
        "to": "lb"
      },
      {
        "from": "lb",
        "to": "app1"
      },
      {
        "from": "lb",
        "to": "app2"
      },
      {
        "from": "app1",
        "to": "db"
      },
      {
        "from": "app2",
        "to": "db"
      }
    ]
  }
}
